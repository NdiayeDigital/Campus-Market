{
  "compilerOptions": {
    "target": "ES2020",
    "module": "None",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "types": []
  },
  "include": ["js/**/*.ts"],
  "exclude": ["node_modules", "js/**/*.js"]
}
