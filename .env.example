# ==============================================================================
# CAMPUS MARKET - FICHIER D'EXEMPLE DES VARIABLES D'ENVIRONNEMENT (.env.example)
# Université Iba Der Thiam de Thiès (UIDT)
# ==============================================================================
# Copiez ce fichier sous le nom ".env.local" pour le développement en local,
# et configurez ces variables dans les paramètres Vercel pour la production :
# Vercel Project -> Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONFIGURATION CLIENT / FRONTEND (Préfixe VITE_ obligatoire)
# Ces variables sont injectées dans le bundle JavaScript public côté navigateur.
# ------------------------------------------------------------------------------

# URL publique de votre projet Supabase
# Trouvée dans : Supabase Dashboard > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://fqulqgdjusfzhcjpvyay.supabase.co

# Clé API publique "anon" / "public" de Supabase
# Trouvée dans : Supabase Dashboard > Project Settings > API > Project API keys > anon
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here


# ------------------------------------------------------------------------------
# 2. CONFIGURATION SECRÈTE / BACKEND (Fonctions Serverless Vercel /api/*)
# ⚠️ ATTENTION : Ne JAMAIS préfixer par VITE_ ! Ces clés doivent rester confidentielles.
# ------------------------------------------------------------------------------

# Clé secrète "service_role" Supabase (Droit d'administration complet, contourne RLS)
# Nécessaire pour :
# - Réinitialisation du mot de passe vendeur par le SuperAdmin (/api/admin-reset-password)
# - Activation automatique des abonnements via Webhook (/api/webhook-saspay)
# - Validation certifiée des paiements (/api/verify-payment)
# Trouvée dans : Supabase Dashboard > Project Settings > API > Project API keys > service_role
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Clé secrète d'API SasPay (Passerelle Wave / Orange Money)
# Nécessaire pour initialiser et vérifier les sessions de checkout SasPay
# Trouvée dans : Tableau de bord SasPay > Paramètres Développeur / Clés API
SASPAY_SECRET_KEY=your_saspay_secret_key_here

# Clé secrète de signature HMAC des Webhooks SasPay
# Utilisée pour vérifier cryptographiquement l'authenticité des notifications IPN
# Trouvée dans : Tableau de bord SasPay > Webhooks > Secret de signature
SASPAY_WEBHOOK_SECRET=your_saspay_webhook_secret_here


# ------------------------------------------------------------------------------
# 3. VARIABLES OPTIONNELLES DE TEST LOCAL & E2E
# ------------------------------------------------------------------------------
# URL de base pour les suites de tests Playwright / End-to-End
# BASE_URL=http://localhost:5173
